# ==============================================================================
# AI-Powered Fact Verification System - Environment Configuration
# ==============================================================================
# Copy this file to `.env` and add your Google AI Studio Gemini API key.
# Never commit your real `.env` file or API keys to version control.

GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-2.5-flash

REQUEST_TIMEOUT_SECONDS=15
DATABASE_PATH=data/fact_verification.db
EXPORTS_DIR=exports
