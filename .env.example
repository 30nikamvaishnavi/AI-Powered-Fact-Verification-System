# ==============================================================================
# AI-Powered Fact Verification System - Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in optional values as needed.
# Never commit your real `.env` file or API keys to version control.

# ------------------------------------------------------------------------------
# Optional Search API Provider Configuration
# ------------------------------------------------------------------------------
# Supported values: auto, tavily, serper, none
# - auto: Automatically uses Tavily or Serper if an API key is configured,
#         otherwise falls back cleanly to Manual Evidence Mode.
# - none: Always runs in Manual Evidence Mode without external search API calls.
SEARCH_PROVIDER="auto"

# Optional Tavily Search API key (https://tavily.com/)
TAVILY_API_KEY=""

# Optional Serper (Google Search JSON API) key (https://serper.dev/)
SERPER_API_KEY=""

# ------------------------------------------------------------------------------
# Retrieval & Storage Settings
# ------------------------------------------------------------------------------
# HTTP request timeout in seconds when fetching publicly accessible webpages
REQUEST_TIMEOUT_SECONDS="8"

# Maximum number of search results to retrieve per claim
MAX_SEARCH_RESULTS="5"

# Path to the local SQLite verification history database
DATABASE_PATH="data/verification_history.db"

# Directory for saved report exports
EXPORTS_DIR="exports"
